# --- Application ---
APP_NAME=QueueLess
APP_ENV=development
APP_DEBUG=true
APP_VERSION=0.1.0

# --- Database (async via asyncpg) ---
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=queueless
DATABASE_PASSWORD=queueless
DATABASE_NAME=queueless

# SQLAlchemy echo (log generated SQL). true/false
DATABASE_ECHO=false

# --- Pool sizes ---
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30

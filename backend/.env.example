# --- Application ---
APP_NAME=QueueLess
APP_ENV=development
APP_DEBUG=true
APP_VERSION=0.1.0

# --- Database (async via asyncpg) ---
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=queueless
DATABASE_PASSWORD=queueless
DATABASE_NAME=queueless

# SQLAlchemy echo (log generated SQL). true/false
DATABASE_ECHO=false

# --- Pool sizes ---
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30

# --- Authentication (JWT) ---
# Dev-only default. MUST be replaced with a strong, random secret in production.
JWT_SECRET_KEY=change-me-queueless-dev-only-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
